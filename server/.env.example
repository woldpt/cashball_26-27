ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Sentry (optional — leave empty to disable error reporting)
SENTRY_DSN=
# Web Push (desligado por defeito: sem ENABLE_PUSH=true nada toca na rede).
# As chaves geram-se com `npx web-push generate-vapid-keys`; com a flag ligada e
# chaves em falta o arranque avisa e os avisos ficam desligados. Saúde do push
# (sent/failed/removed/retried) em GET /health.
ENABLE_PUSH=false
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:push@localhost
